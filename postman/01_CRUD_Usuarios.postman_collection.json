    {
      "name": "4. Listar Usuarios Activos (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code es 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Respuesta es una lista y contiene al menos 2 usuarios\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an(\"array\");",
              "    pm.expect(jsonData.length).to.be.at.least(2);",
              "});",
              "",
              "pm.test(\"Debe mostrar los usuarios activos registrados (Romeo y Carlos Ruiz)\", function () {",
              "    var jsonData = pm.response.json();",
              "    var tieneRomeo = jsonData.some(function (u) {",
              "        return u.nombre && u.nombre.includes(\"Romeo\") && u.activo === true;",
              "    });",
              "    var tieneCarlos = jsonData.some(function (u) {",
              "        return u.nombre && u.nombre.includes(\"Carlos Ruiz\") && u.activo === true;",
              "    });",
              "    ",
              "    pm.expect(tieneRomeo, \"Debe incluir al usuario activo Romeo\").to.be.true;",
              "    pm.expect(tieneCarlos, \"Debe incluir al usuario activo Carlos Ruiz\").to.be.true;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
