    {
      "name": "1. Crear Usuario Cliente (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code es 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Respuesta contiene ID y mensaje de éxito\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property(\"id\");",
              "    pm.expect(jsonData).to.have.property(\"mensaje\");",
              "    pm.expect(jsonData.mensaje).to.eql(\"Usuario registrado con éxito\");",
              "    ",
              "    // Guardar automáticamente el ID devuelto en una variable de colección",
              "    pm.collectionVariables.set(\"clienteId\", jsonData.id.toString());",
              "    console.log(\"Variable clienteId guardada: \" + jsonData.id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Romeo\",\n  \"email\": \"romeo@aragon.unam.mx\",\n  \"password\": \"RomeoPass123\",\n  \"rol\": \"CLIENTE\",\n  \"guid\": \"guid-romeo-001\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/usuarios",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "usuarios"
          ]
        },
        "description": "Registra un nuevo usuario con rol CLIENTE y guarda su ID en la variable clienteId."
      },
      "response": []
