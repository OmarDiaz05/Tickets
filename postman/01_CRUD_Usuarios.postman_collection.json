    {
      "name": "9. Verificar Borrado Lógico en Listado (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code es 200 OK al listar tras borrado lógico\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Romeo ya NO aparece en el listado de usuarios activos\", function () {",
              "    var jsonData = pm.response.json();",
              "    var clienteId = Number(pm.collectionVariables.get(\"clienteId\"));",
              "    var romeoPresente = jsonData.some(function (u) {",
              "        return u.id === clienteId || (u.nombre && u.nombre.includes(\"Romeo\"));",
              "    });",
              "    pm.expect(romeoPresente, \"El usuario deshabilitado (Romeo) no debe estar en activos\").to.be.false;",
              "});",
              "",
              "pm.test(\"Carlos Ruiz CONTINÚA apareciendo en el listado de usuarios activos\", function () {",
              "    var jsonData = pm.response.json();",
              "    var adminId = Number(pm.collectionVariables.get(\"adminId\"));",
              "    var adminPresente = jsonData.some(function (u) {",
              "        return (adminId && u.id === adminId) || (u.nombre && u.nombre.includes(\"Carlos Ruiz\"));",
              "    });",
              "    pm.expect(adminPresente, \"El usuario administrador (Carlos Ruiz) debe seguir activo\").to.be.true;",
